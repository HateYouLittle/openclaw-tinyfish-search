{
  "name": "@HateYouLittle/openclaw-tinyfish-search",
  "version": "0.2.0",
  "description": "TinyFish Search and Fetch providers for OpenClaw web_search and web_fetch, built against the current OpenClaw plugin SDK",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "web-search",
    "tinyfish",
    "search"
  ],
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "openclaw": ">=2026.5.17"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.5.17",
      "minGatewayVersion": "2026.5.17"
    },
    "build": {
      "openclawVersion": "2026.10.6",
      "pluginSdkVersion": "2026.10.6"
    }
  }
}
